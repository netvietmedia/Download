    <!-- Me Tab Dialogs -->
    <string name="dialog_tos_title">Terms of Service</string>
    <string name="dialog_tos_content">Welcome to Share Now!\n\n1. Acceptance of Terms:\nBy using Share Now, you agree to comply with all applicable laws regarding lawful data transfer.\n\n2. Intellectual Property:\nShare Now is a peer-to-peer (P2P) file transfer technology platform. Users are solely responsible for the content transmitted.\n\n3. Offline Usage:\nFile transfers operate over local Direct Wi-Fi and Hotspots without consuming your cellular mobile data.\n\n4. Data Security:\nAll data streams are verified with CRC32 checksums to ensure file integrity and tamper-free transfer.</string>
    <string name="dialog_policy_title">Privacy Policy</string>
    <string name="dialog_policy_content">Share Now Privacy Commitment:\n\n1. Zero Server File Storage:\nData is transmitted directly from sender to receiver via peer-to-peer (P2P) connection. We never store any of your photos, videos, or files on servers.\n\n2. App Permissions:\n• Storage/Media: Only used to read files you choose to send and save received files.\n• Location/Nearby Devices: Required by Android OS to scan and discover nearby Wi-Fi Direct devices.\n\n3. No Third-Party Sharing:\nYour personal information and file data are never shared, tracked, or sold to third parties.\n\n4. Official Online Policy:\nhttps://sites.google.com/view/nextai-share-now/</string>
    <string name="dialog_about_title">About Share Now</string>
    <string name="dialog_about_content">Share Now - Ultra-Fast P2P File Transfer\n\n• Version: 0.1.2 (Build 3)\n• Engine: P2P Turbo High-Speed Core\n• Privacy Policy: https://sites.google.com/view/nextai-share-now/\n• Supported Platforms: Android, iOS, Windows PC\n\n© 2026 NextAI Inc. All rights reserved.</string>
    <string name="btn_view_online">View Online Policy</string>
    <string name="privacy_policy_url">https://sites.google.com/view/nextai-share-now/</string>

