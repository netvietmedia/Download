<resources>
    <style name="Theme.ShareNow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_gold</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">@bool/is_light_status_bar</item>
    </style>
    <style name="Theme.ShareNow.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_gold</item>
        <item name="android:windowBackground">@color/bg_surface</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ShareNow.Intro" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_gold</item>
        <item name="android:windowBackground">@color/bg_surface</item>
        <item name="android:statusBarColor">@color/bg_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SHAREit" parent="Theme.ShareNow" />

    <style name="Theme.ShareNow.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="RoundedCorner12">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundedCorner8">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="RoundedCornerCircle">
        <item name="cornerSize">50%</item>
    </style>
</resources>
