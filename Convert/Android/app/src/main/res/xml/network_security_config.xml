<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bắt buộc HTTPS 100% cho toàn bộ kết nối ngoài -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Chỉ cho phép cleartext tới máy chủ phát triển cục bộ và trạm phát Hotspot LAN -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.43.1</domain>
        <domain includeSubdomains="true">192.168.49.1</domain>
    </domain-config>
</network-security-config>

