<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/border_dark"
        app:cardBackgroundColor="@color/bg_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Real Photo / Video Thumbnail Loaded via Glide -->
            <ImageView
                android:id="@+id/iv_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Media preview" />

            <!-- Highlight Overlay When Selected -->
            <View
                android:id="@+id/view_selected_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#4D2563EB"
                android:visibility="gone" />

            <!-- Video Info Bar at Bottom (Duration + Play Icon) -->
            <LinearLayout
                android:id="@+id/layout_video_info"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bg_scrim_bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_video_player"
                    app:tint="@color/text_white" />

                <TextView
                    android:id="@+id/tv_video_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Selection Indicator (Top Right) -->
            <ImageView
                android:id="@+id/iv_check_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="5dp"
                android:src="@drawable/ic_check_circle_outline" />

            <!-- Size Tag (Top Left) -->
            <TextView
                android:id="@+id/tv_media_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_margin="5dp"
                android:background="@drawable/bg_thumb_badge"
                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:textColor="@color/text_white"
                android:textSize="8sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
