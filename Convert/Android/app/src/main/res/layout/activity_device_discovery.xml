<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:id="@+id/header_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_white" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btn_back"
            android:text="@string/discovery_title"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_selected_summary_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_tag_chip"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/primary_light"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_toolbar"
        android:orientation="vertical">

        <!-- Radar Animation Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="center">

            <!-- Outer Wave -->
            <View
                android:id="@+id/radar_wave_outer"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_circle_radar" />

            <!-- Mid Wave -->
            <View
                android:id="@+id/radar_wave_mid"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_circle_radar" />

            <!-- Radar Beam -->
            <View
                android:id="@+id/radar_scan_beam"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_centerInParent="true"
                android:alpha="0.7"
                android:background="@drawable/bg_radar_beam" />

            <!-- Center Sender Icon (Shrunk to 1/2) -->
            <RelativeLayout
                android:id="@+id/radar_center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_btn_send">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_send_arrow"
                    app:tint="@color/text_on_primary" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- Status & Instruction -->
        <TextView
            android:id="@+id/tv_status_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/discovery_scanning"
            android:textColor="@color/green_success"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:text="@string/discovery_hint"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

        <!-- Connecting / Waiting State Banner -->
        <LinearLayout
            android:id="@+id/layout_request_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary_light" />

            <TextView
                android:id="@+id/tv_request_status_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/discovery_connecting"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:text="@string/discovery_discovered_header"
            android:textColor="@color/text_gray"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Discovered Devices RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_devices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <!-- Manual IP / Test Fallback Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/btn_manual_connect"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_tag_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/discovery_rescan_btn"
                android:textColor="@color/primary_light"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Banner Ad below discovery action button with blue separator -->
        <LinearLayout
            android:id="@+id/layout_banner_ad_discovery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Thanh chỉ màu xanh ngăn cách quảng cáo AdMob -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:background="@color/primary" />

            <FrameLayout
                android:id="@+id/banner_container_discovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foregroundGravity="center" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
