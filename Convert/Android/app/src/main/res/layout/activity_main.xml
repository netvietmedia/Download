<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- HOME TAB CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_home_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="115dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 1. Top Bar Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/ll_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_share_now_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_white"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Right Header Actions: Coins & 3-Dots Menu -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Coin Button -->
                    <LinearLayout
                        android:id="@+id/btn_coin_header"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_tag_chip"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_coin_star"
                            app:tint="@color/accent_gold" />

                        <TextView
                            android:id="@+id/tv_coin_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/coin_default_balance"
                            android:textColor="@color/accent_gold"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 3-Dots Overflow Menu Button -->
                    <ImageView
                        android:id="@+id/btn_more_menu"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/text_white" />
                </LinearLayout>
            </RelativeLayout>

            <!-- 2. Hero Action Buttons (Send & Receive) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <!-- SEND BUTTON -->
                <RelativeLayout
                    android:id="@+id/btn_send"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_send"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_send_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_alignParentTop="true"
                        android:src="@drawable/ic_send_arrow"
                        app:tint="@color/text_on_primary" />

                    <TextView
                        android:id="@+id/tv_send_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/iv_send_icon"
                        android:layout_marginTop="10dp"
                        android:text="@string/action_send"
                        android:textColor="@color/text_on_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_send_title"
                        android:text="@string/hero_send_sub"
                        android:textColor="#D0E4FF"
                        android:textSize="11sp" />
                </RelativeLayout>

                <!-- RECEIVE BUTTON -->
                <RelativeLayout
                    android:id="@+id/btn_receive"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_receive"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_receive_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_alignParentTop="true"
                        android:src="@drawable/ic_receive_arrow"
                        app:tint="@color/text_on_primary" />

                    <TextView
                        android:id="@+id/tv_receive_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/iv_receive_icon"
                        android:layout_marginTop="10dp"
                        android:text="@string/action_receive"
                        android:textColor="@color/text_on_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tv_receive_title"
                        android:text="@string/hero_receive_sub"
                        android:textColor="#D1FAE5"
                        android:textSize="11sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- 3. VIP Banner -->
            <RelativeLayout
                android:id="@+id/card_vip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_interactive"
                android:clickable="true"
                android:focusable="true"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/iv_vip_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_vip_crown"
                    app:tint="@color/accent_gold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/iv_vip_icon"
                    android:layout_toStartOf="@+id/btn_vip_action"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vip_title"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vip_subtitle"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_vip_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_btn_vip"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/btn_upgrade"
                    android:textColor="@color/text_on_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 4. Quick Categories Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/section_categories"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:columnCount="4">

                <!-- Cat: Apps -->
                <LinearLayout
                    android:id="@+id/cat_apps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tag_chip"
                        android:padding="8dp"
                        android:src="@drawable/ic_app_box"
                        app:tint="@color/primary_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/category_apps"
                        android:textColor="@color/text_light"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Cat: Photos -->
                <LinearLayout
                    android:id="@+id/cat_photos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tag_chip"
                        android:padding="8dp"
                        android:src="@drawable/ic_image_photo"
                        app:tint="#F472B6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/category_photos"
                        android:textColor="@color/text_light"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Cat: Music -->
                <LinearLayout
                    android:id="@+id/cat_music"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tag_chip"
                        android:padding="8dp"
                        android:src="@drawable/ic_music_note"
                        app:tint="#34D399" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/category_music"
                        android:textColor="@color/text_light"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Cat: Videos -->
                <LinearLayout
                    android:id="@+id/cat_videos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tag_chip"
                        android:padding="8dp"
                        android:src="@drawable/ic_video_player"
                        app:tint="#FBBF24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/category_videos"
                        android:textColor="@color/text_light"
                        android:textSize="11sp" />
                </LinearLayout>
            </GridLayout>

            <!-- 5. Feature Card 1: Dọn Rác Tăng Tốc (Cleanit) - FIXED OVERLAP -->
            <RelativeLayout
                android:id="@+id/card_cleanit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_interactive"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_clean_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_clean_brush"
                    app:tint="#EF4444" />

                <TextView
                    android:id="@+id/btn_clean_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_btn_clean"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="@string/btn_clean_now"
                    android:textColor="@color/text_on_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:layout_toEndOf="@id/iv_clean_icon"
                    android:layout_toStartOf="@id/btn_clean_action"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cleanit_title"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_clean_junk_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/cleanit_desc"
                        android:textColor="@color/text_danger_sub"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- 5.1 Native Ad Home (Dưới Card Clean & Boost) -->
            <FrameLayout
                android:id="@+id/layout_native_ad_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- 6. Feature Card 2: Tệp Tin Đã Nhận (Received Files) - REPLACES KÉT AN TOÀN -->
            <RelativeLayout
                android:id="@+id/card_received_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_interactive"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_received_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_folder_received" />

                <TextView
                    android:id="@+id/btn_view_received"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_tag_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/btn_open_view"
                    android:textColor="@color/primary_light"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:layout_toEndOf="@id/iv_received_icon"
                    android:layout_toStartOf="@id/btn_view_received"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/received_files_title"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_received_files_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/received_files_desc"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- 7. Feature Card 3: Muslim Prayer Daily -->
            <RelativeLayout
                android:id="@+id/card_muslim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_interactive"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/iv_muslim_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_mosque"
                    app:tint="@color/green_success" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_toEndOf="@id/iv_muslim_icon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muslim_title"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_muslim_prayer_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/muslim_desc"
                        android:textColor="@color/text_gray"
                        android:textSize="12sp" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ME TAB CONTENT (Giao diện Tôi) -->
    <include
        android:id="@+id/include_tab_me"
        layout="@layout/layout_tab_me" />

    <!-- BROWSER TAB CONTENT (Trình duyệt & Tải video mọi web) -->
    <include
        android:id="@+id/include_tab_browser"
        layout="@layout/layout_tab_browser" />

    <!-- ADMOB BANNER AD CONTAINER WITH BLUE SEPARATOR -->
    <LinearLayout
        android:id="@+id/layout_banner_ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="60dp"
        android:background="@color/bg_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/banner_container_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foregroundGravity="center" />
        <!-- Dong ke xanh ngan giua menu va ads, nam duoi chan banner -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:background="@color/primary" />

    </LinearLayout>

    <!-- Bottom Navigation Bar (Chỉ còn Trang chủ và Tôi) -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/nav_btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_send_arrow"
                app:tint="@color/primary_light" />

            <TextView
                android:id="@+id/tv_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textColor="@color/primary_light"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_btn_browser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_browser"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_browser_globe"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_nav_browser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_browser"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_btn_me"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_me"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_menu_invite"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tv_nav_me"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_me"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
