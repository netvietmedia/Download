<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <RelativeLayout
        android:id="@+id/header_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btn_back"
            android:text="@string/safebox_header"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Keypad & PIN view container -->
    <LinearLayout
        android:id="@+id/layout_pin_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_toolbar"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_vault_lock"
            app:tint="@color/primary_light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/safebox_pin_prompt"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/safebox_aes_desc"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

        <!-- 4 Masked PIN Indicator Dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dot_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle_radar" />

            <TextView
                android:id="@+id/dot_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle_radar" />

            <TextView
                android:id="@+id/dot_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle_radar" />

            <TextView
                android:id="@+id/dot_4"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle_radar" />
        </LinearLayout>

        <!-- Numeric Keypad Grid 3x4 -->
        <GridLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:useDefaultMargins="true">

            <!-- 1 to 9 -->
            <TextView
                android:id="@+id/key_1"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_2"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_3"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_4"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_5"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_6"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_7"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_8"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="8"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_9"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="9"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Empty slot -->
            <View
                android:layout_width="68dp"
                android:layout_height="68dp" />

            <TextView
                android:id="@+id/key_0"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_delete"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_card_interactive"
                android:gravity="center"
                android:text="⌫"
                android:textColor="@color/text_white"
                android:textSize="22sp" />
        </GridLayout>

    </LinearLayout>

    <!-- Vault Unlocked Container -->
    <LinearLayout
        android:id="@+id/layout_vault_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_toolbar"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_vault_lock"
            app:tint="@color/green_success" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/safebox_ready_title"
            android:textColor="@color/green_success"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/safebox_empty_desc"
            android:textAlignment="center"
            android:textColor="@color/text_gray"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/safebox_security_title"
                android:textColor="@color/primary_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/safebox_features_desc"
                android:textColor="@color/text_white"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_add_vault_file"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_btn_send"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/safebox_add_files"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_lock_vault"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_interactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/safebox_btn_lock_exit"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
