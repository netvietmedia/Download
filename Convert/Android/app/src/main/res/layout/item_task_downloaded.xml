<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_task_downloaded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_dark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Video Thumbnail Box (Matches item_received_file.xml with real video frame + Play overlay) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_play_downloaded"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_card"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/iv_downloaded_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_fill"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_downloaded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="Video_Title.mp4"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_downloaded_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/browser_status_completed_100"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_downloaded_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Saved • Movies/ShareNow"
                android:textColor="@color/green_success"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Primary Action Button matching item_received_file.xml btn_open_file -->
        <TextView
            android:id="@+id/btn_play_downloaded"
            android:layout_width="68dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_btn_send"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/btn_open_file"
            android:textColor="@color/text_on_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_downloaded_more"
            android:layout_width="32dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_gray" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
